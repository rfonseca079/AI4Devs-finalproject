# Copy this file to .env in the repository root before `docker compose up`.
# Every value below is a placeholder. Replace it before any real deployment.
# These strings are not production secrets. Production startup rejects
# change-me-* and mecatrack-docker-* JWT values, and database passwords
# mecatrack, postgres, and password.

POSTGRES_USER=replace-this-db-user
POSTGRES_PASSWORD=replace-this-db-password
POSTGRES_DB=replace-this-db-name

# At least 32 characters. Use a unique value; do not keep this placeholder.
JWT_ACCESS_SECRET=replace-this-access-secret-with-32-plus-chars
JWT_REFRESH_SECRET=replace-this-refresh-secret-with-32-plus-chars

# Required only before `docker compose --profile observability up`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-this-grafana-password

# Leave false unless this is an empty database and you intend to create the first admin.
ENABLE_ADMIN_BOOTSTRAP=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=

ENABLE_HSTS=false

# Published web port. Choose one for this deployment; do not treat a sample port as required.
# WEB_PORT=3000

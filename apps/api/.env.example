# Development (this repo). Production: 5434 / 4010→4000 / 3010→3000.
#
# Development may use local placeholders below.
# Production (or ENFORCE_SECURE_CONFIG=true) MUST use unique secrets (>=32 chars)
# and a non-trivial DATABASE_URL password. Placeholders are rejected at API startup.

DATABASE_URL=postgresql://mecatrack:mecatrack@localhost:5435/mecatrack_dev
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=4010
NODE_ENV=development
CORS_ORIGIN=http://localhost:3010

# Set to true locally to exercise production-strict secret validation without
# switching NODE_ENV. Leave unset/false for normal development.
# ENFORCE_SECURE_CONFIG=false

# Enable Strict-Transport-Security only behind HTTPS
# ENABLE_HSTS=false

# Destructive DB scripts (DEV/test only). Never set to true in production.
# ALLOW_DESTRUCTIVE_DB_OPS=true

# Optional one-time first-admin bootstrap (empty User table only). Never auto-seed demos.
# ENABLE_ADMIN_BOOTSTRAP=false
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
